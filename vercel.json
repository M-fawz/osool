{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run vercel-build",
  "regions": [
    "fra1"
  ],
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/sweep?only=reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sweep?only=lifecycle&only=audit-since",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/sweep?only=signals",
      "schedule": "0 3 * * 1"
    }
  ]
}
