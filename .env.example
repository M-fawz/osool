# ─────────────────────────────────────────────────────────────────────────────
# Osool — environment template
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# never be committed. This file carries no real secret, only placeholders.
#
#   cp .env.example .env
#
# For a hosted deployment, none of this file is used: the same variable NAMES
# are set in the host's own configuration. Which of them belong to Development,
# Preview, and Production is the table in docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Docker path (npm run db:start with Docker installed) uses port 5433 so it can
# never collide with a PostgreSQL already installed on the machine.
DATABASE_URL="postgresql://osool:osool_dev_password@localhost:5433/osool?schema=public"

# A direct, unpooled connection to the same database. Migrations use it, and
# nothing else does.
#
# Only needed where DATABASE_URL goes through a transaction-mode pooler —
# Supabase's port 6543, Neon's `-pooler` host, any PgBouncer. Those are what a
# serverless runtime needs and exactly what schema migrations cannot use: DDL
# and Prisma's advisory lock need one session that stays put. Leave it unset
# locally and against a plain Postgres; migrations then use DATABASE_URL.
# DIRECT_DATABASE_URL=""

# ── Application ─────────────────────────────────────────────────────────────
# The public address of this deployment. Leave it unset on a host that reports
# its own hostname (Vercel does) — it is derived per environment so that a
# preview never sends activation links pointing at production.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate a fresh 32-byte secret. Never reuse the placeholder below.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-me-with-a-generated-32-byte-secret"
# Defaults to APP_URL. Set it only where auth answers on a different address.
BETTER_AUTH_URL="http://localhost:3000"

# Extra origins the browser may legitimately be on, comma-separated. Needed only
# for an address the host does not report — a second custom domain, say.
# EXTRA_TRUSTED_ORIGINS=""

# ── Transactional email ─────────────────────────────────────────────────────
# Activation and verification emails are really sent. There is deliberately no
# outbox table an administrator has to read links out of by hand.
#
#   EMAIL_PROVIDER=console  → dev default. Writes the full message, including
#                             the activation URL, to the server console.
#   EMAIL_PROVIDER=resend   → sends through Resend. Required in production,
#                             and in a Vercel preview, which also runs with
#                             NODE_ENV=production.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Osool — سجل الوسطاء العقاريين <no-reply@osool.gov.eg>"

# ── Object storage ──────────────────────────────────────────────────────────
# Uploads are hashed on receipt and stored content-addressed. Never overwritten.
#   STORAGE_DRIVER=local → dev default, writes under ./.storage
#   STORAGE_DRIVER=s3    → any S3-compatible endpoint
#
# `local` is refused in production and on a serverless host, where the
# filesystem is read-only and a deployment would lose every uploaded document.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Only for a provider that issues temporary credentials. On AWS this is what STS
# returns with an assumed role. Supabase Storage uses the same field to accept a
# JWT: project ref as the key id, anon key as the secret, service-role key here.
# Leave empty for a static key pair — an empty token is not sent.
S3_SESSION_TOKEN=""

# The largest request body the host in front of this process will pass through,
# in megabytes. A platform ceiling, not a regulatory one — the per-document
# limits stay in the DOC_CHECKLIST rule set. Derived automatically (4.5 on a
# serverless host, 25 otherwise); set it only to override.
# UPLOAD_MAX_REQUEST_MB=""

# ── Arabic PDF rendering ────────────────────────────────────────────────────
# Which Chromium renders registration cards. Detected from the host; set it only
# to force a path.
#   bundled-chromium    → the browser `npx playwright install chromium` put on
#                         disk. Local development and container deployments.
#   serverless-chromium → @sparticuz/chromium, unpacked into /tmp. Vercel, Lambda.
# PDF_RENDERER=""

# ── Encryption at rest ──────────────────────────────────────────────────────
# Application-level encryption key for identifying personal data (REQ-DPA-002).
# 32 bytes, base64url. Generate the same way as BETTER_AUTH_SECRET.
# Rotating this without re-encrypting existing rows makes that data unreadable.
PII_ENCRYPTION_KEY="replace-me-with-a-generated-32-byte-secret"

# ── Locale ──────────────────────────────────────────────────────────────────
# Arabic is the default. English is a full mirror, not a fallback.
DEFAULT_LOCALE="ar"
