# ─────────────────────────────────────────────────────────────────────────────
# Osool — environment template
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# never be committed. This file carries no real secret, only placeholders.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Docker path (npm run db:start with Docker installed) uses port 5433 so it can
# never collide with a PostgreSQL already installed on the machine.
DATABASE_URL="postgresql://osool:osool_dev_password@localhost:5433/osool?schema=public"

# ── Application ─────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate a fresh 32-byte secret. Never reuse the placeholder below.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-me-with-a-generated-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ── Transactional email ─────────────────────────────────────────────────────
# Activation and verification emails are really sent. There is deliberately no
# outbox table an administrator has to read links out of by hand.
#
#   EMAIL_PROVIDER=console  → dev default. Writes the full message, including
#                             the activation URL, to the server console.
#   EMAIL_PROVIDER=resend   → sends through Resend. Required in production.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Osool — سجل الوسطاء العقاريين <no-reply@osool.gov.eg>"

# ── Object storage ──────────────────────────────────────────────────────────
# Uploads are hashed on receipt and stored content-addressed. Never overwritten.
#   STORAGE_DRIVER=local → dev default, writes under ./.storage
#   STORAGE_DRIVER=s3    → any S3-compatible endpoint
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./.storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Encryption at rest ──────────────────────────────────────────────────────
# Application-level encryption key for identifying personal data (REQ-DPA-002).
# 32 bytes, base64url. Generate the same way as BETTER_AUTH_SECRET.
# Rotating this without re-encrypting existing rows makes that data unreadable.
PII_ENCRYPTION_KEY="replace-me-with-a-generated-32-byte-secret"

# ── Locale ──────────────────────────────────────────────────────────────────
# Arabic is the default. English is a full mirror, not a fallback.
DEFAULT_LOCALE="ar"
